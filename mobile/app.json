{
  "expo": {
    "name": "Kizayu",
    "slug": "kizayu",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kizayu.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kizayu.app",
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Kizayu needs access to your photos so you can share them with your circles.",
          "cameraPermission": "Kizayu needs the camera so you can snap and share moments."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Kizayu uses your location only when you choose to share it with your circles."
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#00C8F0"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0C"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Kizayu uses the camera to record video when you send an SOS, and shares it with your emergency contacts.",
          "microphonePermission": "Kizayu uses the microphone to record audio when you send an SOS, and shares it with your emergency contacts.",
          "recordAudioAndroid": true
        }
      ]
    ],
    "scheme": "kizayu",
    "description": "Kizayu keeps families close: share moments, look after each other's health, plan the day together and stay safe.",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "576a9e82-fc53-424b-9dfe-d1ba7bcee436"
      }
    },
    "owner": "astonixai",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/576a9e82-fc53-424b-9dfe-d1ba7bcee436"
    }
  }
}
