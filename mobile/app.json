{
  "expo": {
    "name": "Kizayu",
    "slug": "kizayu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kizayu.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kizayu.app",
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Kizayu needs access to your photos so you can share them with your circles.",
          "cameraPermission": "Kizayu needs the camera so you can snap and share moments."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Kizayu uses your location only when you choose to share it with your circles."
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#00C8F0"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0C"
        }
      ]
    ],
    "scheme": "kizayu",
    "description": "Kizayu keeps families close: share moments, look after each other's health, plan the day together and stay safe."
  }
}
