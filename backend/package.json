{
  "name": "kizayu-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "prisma migrate deploy && tsx prisma/seed.ts && tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "seed": "tsx prisma/seed.ts",
    "setup": "prisma generate && prisma migrate deploy && tsx prisma/seed.ts",
    "test": "tsx --env-file=.env scripts/test.ts",
    "db": "tsx --env-file=.env scripts/devdb.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.4",
    "google-auth-library": "^11.3.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.5.0",
    "socket.io": "^4.8.4",
    "zod": "^3.23.8",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "embedded-postgres": "^17.11.0-beta.19",
    "socket.io-client": "^4.8.4",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
