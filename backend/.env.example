# Local dev database started by `npm run db` (embedded Postgres, dev-only credentials).
DATABASE_URL="postgresql://kinloop:kinloop_dev_pw@localhost:5433/kinloop"
JWT_SECRET="dev-only-change-me"          # production: random string, 32+ characters
PORT=4000
NODE_ENV=development                      # production: production

# --- Optional: uncomment and fill in to switch each feature from dev mode to the real service ---
# CORS_ORIGINS="https://app.example.com"
# PUBLIC_URL="https://api.example.com"
# SMTP_URL="smtps://user:pass@smtp.example.com:465"   # password-reset emails
# MAIL_FROM="Kizayu <no-reply@example.com>"
# SUPPORT_EMAIL="support@example.com"                  # copy of each support ticket
# TWILIO_ACCOUNT_SID=""                                # SMS sign-in codes
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM="+10000000000"
# GOOGLE_CLIENT_IDS="web-id.apps.googleusercontent.com,android-id...,ios-id..."
# EXPO_ACCESS_TOKEN=""                                 # only if push security is enabled in Expo
# S3_BUCKET="" S3_REGION="ap-south-1" S3_PUBLIC_URL="https://cdn.example.com"
# PG_BIN_DIR="C:\Program Files\PostgreSQL\17\bin"     # optional, see scripts/devdb.ts
