generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"] // native = this PC; debian = the Docker image used in production
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  email        String?  @unique
  phone        String?  @unique // E.164, e.g. +919876543210
  googleId     String?  @unique
  passwordHash String?
  avatarUrl    String?
  age          Int?
  gender       String?
  premium      Boolean  @default(false) // cached; source of truth is Subscription
  status       String   @default("Active") // Active | All good | Busy
  createdAt    DateTime @default(now())

  memberships   CircleMember[]
  posts         Post[]
  likes         Like[]
  comments      Comment[]
  stories       Story[]
  tasks         Task[]
  appointments  Appointment[]
  pulseEvents   PulseEvent[]
  vitals        Vital[]
  medications   Medication[]
  records       HealthRecord[]
  gameScores    GameScore[]
  doctorLinks   DoctorLink[]
  messages      Message[]
  location      LocationShare?
  safety        SafetySetting?
  pushTokens    PushToken[]
  notifications Notification[]
  subscriptions Subscription[]
  tickets       SupportTicket[]
  doctorThreads DoctorThread[]
  doctorMsgs    DoctorMessage[]
  doctorProfile Doctor?        @relation("DoctorAccount")
  reports       Report[]
  emergency     EmergencyInfo?
  sosContacts   SosContact[]
  sosEvents     SosEvent[]
  activities    Activity[]
  tzOffsetMin   Int      @default(0)  // minutes behind UTC, as JS getTimezoneOffset() reports (India = -330); set by the app
  nudgeDate     String?              // last local day the evening "still pending" nudge was sent
  memoryDate    String?              // last local day an "on this day" nudge was sent
  habits        Habit[]
  brainResults  BrainResult[]
  brainShare    Boolean  @default(false) // show my brain streak to my circles
  subjects      Subject[]
  assignments   Assignment[]
  slots         TimetableSlot[]
  studyNotes    StudyNote[]
  buddyMessages BuddyMessage[]
  checkIns      CheckIn[]
  notifyPrefs   NotifyPrefs?
  rsvps         EventRsvp[]
  blocking      Block[]        @relation("Blocker")
  blockedBy     Block[]        @relation("Blocked")
}

model VerificationCode {
  id        String    @id @default(cuid())
  kind      String    // password_reset | phone_login
  target    String    // email or phone
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  @@index([kind, target])
}

model Circle {
  id         String   @id @default(cuid())
  name       String
  type       String   // Family | Friends | Relatives
  inviteCode String   @unique @default(cuid())
  createdAt  DateTime @default(now())
  members    CircleMember[]
  posts      Post[]
  pulse      PulseEvent[]
  messages   Message[]
  lists       SharedList[]
  events      FamilyEvent[]
  challenges  Challenge[]
  chores      Chore[]
  rewards     Reward[]
  albums      Album[]
}

model CircleMember {
  id       String @id @default(cuid())
  circleId String
  userId   String
  role     String @default("member") // owner | member
  circle   Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([circleId, userId])
}

model Post {
  id        String   @id @default(cuid())
  authorId  String
  circleId  String?
  kind      String   @default("snap") // snap | checkin | activity
  caption   String?
  imageUrl  String?
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  circle    Circle?  @relation(fields: [circleId], references: [id], onDelete: SetNull)
  likes     Like[]
  comments  Comment[]
  @@index([circleId, createdAt])
}

model Like {
  postId String
  userId String
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([postId, userId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  text      String
  createdAt DateTime @default(now())
  post      Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Story {
  id        String   @id @default(cuid())
  authorId  String
  imageUrl  String
  createdAt DateTime @default(now())
  expiresAt DateTime
  author    User @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model Task {
  id          String   @id @default(cuid())
  userId      String
  title       String
  subtitle    String?
  icon        String   @default("check")
  dueTime     String?
  targetCount Int      @default(1)
  doneCount   Int      @default(0)
  doneDate    String?
  createdAt   DateTime @default(now())
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Appointment {
  id       String   @id @default(cuid())
  userId   String
  title    String
  kind     String   @default("doctor") // doctor | call | other
  startsAt DateTime
  notified1d Boolean @default(false)
  notified1h Boolean @default(false)
  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PulseEvent {
  id        String   @id @default(cuid())
  circleId  String
  userId    String
  kind      String   // completed | appointment | photo | alert
  text      String
  imageUrl  String?
  createdAt DateTime @default(now())
  circle    Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([circleId, createdAt])
}

model Vital {
  id         String   @id @default(cuid())
  userId     String
  type       String   // heart_rate | bp | spo2
  value      String
  unit       String
  recordedAt DateTime @default(now())
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Medication {
  id        String  @id @default(cuid())
  userId    String
  name      String
  schedule  String
  remindAt  String?   // "HH:MM" (24h): the app schedules a daily reminder at this time
  missedDate String?  // last local day the family was told this dose was missed
  takenDate String?
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model HealthRecord {
  id        String   @id @default(cuid())
  userId    String
  type      String   // prescription | lab | history | appointment
  title     String
  notes     String?
  fileUrl   String?
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Doctor {
  id        String  @id @default(cuid())
  name      String
  specialty String
  rating    Float
  reviews   Int
  phone     String?
  avatarUrl String?
  userId    String? @unique // doctor's own login, for the doctor inbox
  user      User?   @relation("DoctorAccount", fields: [userId], references: [id], onDelete: SetNull)
  links     DoctorLink[]
  threads   DoctorThread[]
}

model DoctorLink {
  id         String @id @default(cuid())
  userId     String
  doctorId   String
  sharedWith String @default("")
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctor     Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  @@unique([userId, doctorId])
}

model DoctorThread {
  id        String   @id @default(cuid())
  patientId String
  doctorId  String
  updatedAt DateTime @default(now()) @updatedAt
  patient   User     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  messages  DoctorMessage[]
  @@unique([patientId, doctorId])
}

model DoctorMessage {
  id        String   @id @default(cuid())
  threadId  String
  senderId  String
  text      String
  createdAt DateTime @default(now())
  readAt    DateTime?
  thread    DoctorThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender    User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  @@index([threadId, createdAt])
}

model Game {
  id      String @id @default(cuid())
  title   String
  tagline String
  icon    String
  scores  GameScore[]
}

model GameScore {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  score     Int
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
}

model Message {
  id        String   @id @default(cuid())
  circleId  String
  userId    String
  text      String?
  imageUrl  String?
  createdAt DateTime @default(now())
  circle    Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([circleId, createdAt])
}

model LocationShare {
  userId       String    @id
  lat          Float
  lng          Float
  label        String?
  sharingWith  String?
  sharingUntil DateTime?
  updatedAt    DateTime  @default(now()) @updatedAt
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SafetySetting {
  userId       String  @id
  homeAlerts   Boolean @default(true)
  sosAlert     Boolean @default(true)
  shareJourney Boolean @default(false)
  sosRecording Boolean @default(false) // opt-in: record + share video/audio during an SOS
  homeLat      Float?
  homeLng      Float?
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushToken {
  token     String   @id // ExponentPushToken[...]
  userId    String
  platform  String   // ios | android
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String    // chat | sos | comment | doctor | home | system
  title     String
  body      String
  data      String    @default("{}") // JSON: where to navigate
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String
  plan      String   // monthly | yearly
  provider  String   // dev | google | apple
  status    String   // active | canceled
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model SupportTicket {
  id        String   @id @default(cuid())
  userId    String
  subject   String
  message   String
  status    String   @default("open") // open | closed
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Content reports from users (the app stores require a way to report abusive content). Reviewed by the team.
model Report {
  id         String   @id @default(cuid())
  reporterId String
  targetType String   // post | comment | message | user
  targetId   String
  reason     String   // spam | harassment | inappropriate | other
  details    String?
  status     String   @default("open") // open | resolved
  createdAt  DateTime @default(now())
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  @@unique([reporterId, targetType, targetId])
}

// Posts, comments, stories, messages and notifications from a blocked person are hidden from the blocker.
model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  @@id([blockerId, blockedId])
}

// A shared checklist for a circle (groceries, packing, to-dos). Everyone in the circle can add and tick items.
model SharedList {
  id          String   @id @default(cuid())
  circleId    String
  title       String
  icon        String   @default("cart")
  createdById String?
  createdAt   DateTime @default(now())
  circle      Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  items       SharedListItem[]
  @@index([circleId])
}

model SharedListItem {
  id        String    @id @default(cuid())
  listId    String
  text      String
  addedById String?
  doneAt    DateTime?
  doneById  String?
  createdAt DateTime  @default(now())
  list      SharedList @relation(fields: [listId], references: [id], onDelete: Cascade)
  @@index([listId])
}

// Medical ID: what family or a first responder needs to know in an emergency. Visible to people in your circles.
model EmergencyInfo {
  userId       String   @id
  bloodGroup   String?
  allergies    String?
  conditions   String?
  contactName  String?  // deprecated: contacts now live in SosContact (kept so no data is lost)
  contactPhone String?  // deprecated
  notes        String?
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A user's emergency contacts: shown on their emergency card (visible to their circles) and sent an SMS with a
// private link when they raise an SOS. People here are often family who don't have the app.
model SosContact {
  id        String   @id @default(cuid())
  userId    String
  name      String
  relation  String?  // Mom, Spouse, Friend...
  phone     String   // E.164
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, phone])
}

// One SOS. "token" is the unguessable part of the public link (/s/<token>) sent to contacts.
model SosEvent {
  id           String    @id @default(cuid())
  userId       String
  token        String    @unique
  lat          Float?
  lng          Float?
  locUpdatedAt DateTime?
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clips        SosClip[]
  @@index([userId])
  @@index([startedAt])
}

// Short recorded clips (video with audio) uploaded while the SOS is active.
model SosClip {
  id        String   @id @default(cuid())
  eventId   String
  kind      String   // video | audio
  url       String
  bytes     Int
  seconds   Int?
  createdAt DateTime @default(now())
  event     SosEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  @@index([eventId])
}

// A recorded workout (walk, run or cycle) with its GPS route. Calories and steps are estimated on the server.
model Activity {
  id          String   @id @default(cuid())
  userId      String
  kind        String   // walk | run | cycle
  title       String?
  note        String?
  startedAt   DateTime
  durationSec Int
  distanceM   Int
  calories    Int
  steps       Int?     // estimated from distance (walk and run only)
  route       Json     // [[lat, lng], ...] simplified, at most 600 points
  shared      Boolean  @default(true) // shown to people in your circles and counted on the leaderboard
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, startedAt])
  @@index([startedAt])
}

// ---------------------------------------------------------------- notification preferences
model NotifyPrefs {
  userId   String  @id
  chat     Boolean @default(true)
  comments Boolean @default(true)
  events   Boolean @default(true)  // calendar invites + reminders
  care     Boolean @default(true)  // missed-medicine and arrived-home alerts about family
  nudges   Boolean @default(true)  // evening "still pending" + "on this day"
  fitness  Boolean @default(true)  // challenges + "passed you"
  chores   Boolean @default(true)
  study    Boolean @default(true)  // assignments due + brain-streak nudges
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------- daily habits
model Habit {
  id        String   @id @default(cuid())
  userId    String
  title     String
  icon      String   @default("star")
  target    Int      @default(1)  // times per day
  remindAt  String?  // "HH:MM" local; the app schedules a daily phone reminder
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs      HabitLog[]
  @@index([userId])
}

model HabitLog {
  id      String @id @default(cuid())
  habitId String
  date    String // the user's local day, "YYYY-MM-DD"
  count   Int    @default(1)
  habit   Habit  @relation(fields: [habitId], references: [id], onDelete: Cascade)
  @@unique([habitId, date])
}

// ---------------------------------------------------------------- safe-walk check-ins
model CheckIn {
  id         String    @id @default(cuid())
  userId     String
  dueAt      DateTime
  note       String?
  lat        Float?
  lng        Float?
  status     String    @default("active") // active | safe | alerted
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([status, dueAt])
}

// ---------------------------------------------------------------- family calendar
model FamilyEvent {
  id             String    @id @default(cuid())
  circleId       String
  createdById    String?
  title          String
  notes          String?
  kind           String    @default("event")  // event | birthday | anniversary
  startsAt       DateTime
  allDay         Boolean   @default(false)
  repeat         String    @default("none")   // none | yearly
  notified1dFor  DateTime? // the occurrence the 1-day reminder was last sent for
  notified1hFor  DateTime? // the occurrence the 1-hour reminder was last sent for
  createdAt      DateTime  @default(now())
  circle         Circle    @relation(fields: [circleId], references: [id], onDelete: Cascade)
  rsvps          EventRsvp[]
  @@index([circleId, startsAt])
}

model EventRsvp {
  eventId String
  userId  String
  status  String // yes | maybe | no
  event   FamilyEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([eventId, userId])
}

// ---------------------------------------------------------------- family challenges
model Challenge {
  id          String   @id @default(cuid())
  circleId    String
  createdById String?
  title       String
  metric      String   // distance (metres) | workouts (count)
  target      Int
  startsAt    DateTime
  endsAt      DateTime
  createdAt   DateTime @default(now())
  circle      Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  wins        ChallengeWin[]
  @@index([circleId, endsAt])
}

model ChallengeWin {
  challengeId String
  userId      String
  at          DateTime  @default(now())
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  @@id([challengeId, userId])
}

// ---------------------------------------------------------------- chores and rewards
model Chore {
  id          String   @id @default(cuid())
  circleId    String
  title       String
  points      Int
  assigneeId  String?
  createdById String?
  repeat      String   @default("daily") // once | daily | weekly
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  circle      Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  dones       ChoreDone[]
  @@index([circleId])
}

model ChoreDone {
  id           String   @id @default(cuid())
  choreId      String
  userId       String
  date         String   // local day, "YYYY-MM-DD"
  status       String   @default("pending") // pending | approved | rejected
  approvedById String?
  points       Int
  createdAt    DateTime @default(now())
  chore        Chore    @relation(fields: [choreId], references: [id], onDelete: Cascade)
  @@unique([choreId, userId, date])
  @@index([userId])
}

model Reward {
  id          String   @id @default(cuid())
  circleId    String
  title       String
  cost        Int
  createdById String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  circle      Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  claims      RewardClaim[]
  @@index([circleId])
}

model RewardClaim {
  id        String   @id @default(cuid())
  rewardId  String
  userId    String
  cost      Int
  status    String   @default("pending") // pending | given
  createdAt DateTime @default(now())
  reward    Reward   @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  @@index([userId])
}

// ---------------------------------------------------------------- photo albums
model Album {
  id          String   @id @default(cuid())
  circleId    String
  title       String
  createdById String?
  createdAt   DateTime @default(now())
  circle      Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  photos      AlbumPhoto[]
  @@index([circleId])
}

model AlbumPhoto {
  id           String   @id @default(cuid())
  albumId      String
  url          String
  caption      String?
  uploadedById String?
  createdAt    DateTime @default(now())
  album        Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  @@index([albumId])
}

// ---------------------------------------------------------------- brain gym
model BrainResult {
  id        String   @id @default(cuid())
  userId    String
  game      String   // math | matrix | stroop | quant
  score     Int
  xp        Int
  date      String   // the user's local day, "YYYY-MM-DD"
  daily     Boolean  @default(false) // the shared Daily Challenge run (counts once per game per day)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, date])
}

// ---------------------------------------------------------------- student workspace (private to each person)
model Subject {
  id        String    @id @default(cuid())
  userId    String
  name      String
  color     String    @default("#18B8D9")
  examDate  String?   // "YYYY-MM-DD"
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapters  Chapter[]
  @@index([userId])
}

model Chapter {
  id        String   @id @default(cuid())
  subjectId String
  title     String
  done      Boolean  @default(false)
  position  Int      @default(0)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  @@index([subjectId])
}

model Assignment {
  id         String    @id @default(cuid())
  userId     String
  subjectId  String?
  title      String
  dueDate    String?   // "YYYY-MM-DD"
  priority   String    @default("normal") // low | normal | high
  done       Boolean   @default(false)
  doneAt     DateTime?
  notifiedOn String?   // last local day a "due tomorrow" alert was sent
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, done])
}

model TimetableSlot {
  id        String   @id @default(cuid())
  userId    String
  subjectId String?
  title     String
  weekday   Int?     // 0 = Sunday .. 6 = Saturday, for weekly repeats
  date      String?  // "YYYY-MM-DD" for a one-off slot
  startMin  Int      // minutes since local midnight
  endMin    Int
  note      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model StudyNote {
  id        String   @id @default(cuid())
  userId    String
  subjectId String?
  kind      String   @default("note") // note | formula | link | file
  title     String
  body      String   @default("")
  url       String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

// ---------------------------------------------------------------- study buddy chat (private to each person)
model BuddyMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String   // user | buddy
  text      String
  mood      String?  // energetic | chill | stressed | sleepy, sent with a user message
  source    String?  // for buddy replies: model | scripted | safety
  date      String   // the user's local day, used for the daily message limit
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}
